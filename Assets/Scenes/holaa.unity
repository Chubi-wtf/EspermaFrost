  m_Name: 
  m_EditorClassIdentifier: 
  natashaComments:
  - "La verdad es que jam\xE1s entend\xED por qu\xE9 est\xE1n esos numeros por toda
    la nave."
  - "Recuerda el plan: activa el generador primero. \xBFEs eso?"
  - "Los numeros siempre los numeros... \xBFQu\xE9 significan?"
  - "Los numeros parecen importantes, pero no s\xE9 por qu\xE9."
  - "los numeros, por qu\xE9 siempre debe haber numeros..."
  cooldown: 10
  commentDisplayTime: 3
  typingSpeed: 0.04
  natashaCommentPanel: {fileID: 1938890003}
  natashaCommentText: {fileID: 696343111}
