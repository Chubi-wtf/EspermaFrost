  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Dale a un granjero semillas, y te dar\xE1 comida.\nDale a un m\xFAsico
    una melod\xEDa, y te dar\xE1 m\xFAsica. \nDale a un soldado un enemigo, y te
    dar\xE1 nada... \xC9l solo destruye... Mata...\r\n\n\r\nMe pregunto si Dios observa
    los eventos que se desarrollan, cuando los hombres se revelan contra si mismos.
    \nTengo miedo de que al morir, a Dios le importe las cosas que hice, pero tengo
    m\xE1s miedo de que no le importe; que estar\xE1 ah\xED sentado, cort\xE1ndose
    las u\xF1as y con apenas energ\xEDa para juzgarme. \n\n\nPero, \xBFY entonces
    qu\xE9? \xBFQu\xE9 pasa si a los hombres no se les juzga como corresponde?\r\n\r\nLa
    gente dice que le tema al infierno, pero, hay un punto en que has hecho tantas
    atrocidades que si llegas al infierno, el diablo te juzgar\xE1 como un amigo...
    Pero la verdad es: \n\nQue ya dej\xE9 de creer en algo..."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8b75d692b9a90914ba4bbbc4beb45d43, type: 2}
  m_sharedMaterial: {fileID: -8069470037544196331, guid: 8b75d692b9a90914ba4bbbc4beb45d43, type: 2}
